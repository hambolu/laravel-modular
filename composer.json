{
    "name": "laravelmodular/modular",
    "description": "A powerful NestJS-inspired modular architecture for Laravel — write less, do more.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "modules", "modular", "architecture", "nestjs"],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/console": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/routing": "^10.0|^11.0",
        "illuminate/events": "^10.0|^11.0",
        "illuminate/container": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelModular\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelModular\\ModularServiceProvider"
            ],
            "aliases": {
                "Module": "LaravelModular\\Facades\\Module"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
